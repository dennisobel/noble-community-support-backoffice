{
  "name": "noble-community-support",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Monorepo root: the back office and worker portal (apps/web), the API (apps/api) and the rules both share (packages/shared).",
  "scripts": {
    "dev": "pnpm --filter @noble/web dev",
    "dev:api": "pnpm --filter @noble/api dev",
    "build": "pnpm --filter @noble/web build",
    "build:api": "pnpm --filter @noble/api build",
    "build:all": "pnpm --filter @noble/api build && pnpm --filter @noble/web build",
    "preview": "pnpm --filter @noble/web preview",
    "check": "pnpm --filter @noble/web typecheck && pnpm --filter @noble/api typecheck",
    "test": "pnpm --filter @noble/api test",
    "seed:demo": "pnpm --filter @noble/api cli seed-demo",
    "seed:sample": "pnpm --filter @noble/api cli seed-sample",
    "create-admin": "pnpm --filter @noble/api cli create-admin",
    "format": "prettier --write .",
    "test:e2e": "node e2e/golden-path.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "prettier": "^3.6.2",
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "argon2"
    ]
  }
}
