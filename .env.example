# ─────────────────────────────────────────────────────────────────────────────
# Noble Community Support — environment
# Copy to .env (development) or .env.production (production). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=4100
# Public URL of the web app (used in emails and for the Origin check). Dev: the Vite server (VITE_PORT, default 5173).
APP_URL=http://localhost:5173
# Other addresses the web app is also opened from, comma-separated: for example the server's own
# http://<ip>:9080 beside a domain. A browser may only call the API from APP_URL and these.
ALLOWED_ORIGINS=
APP_TIMEZONE=Australia/Adelaide
LOG_LEVEL=info
# Pretty logs for a host-run API (`pnpm dev:api`); keep false inside Docker.
LOG_PRETTY=true

# MongoDB. Host-run API against the dev container:
MONGO_URI=mongodb://127.0.0.1:27017/noble?directConnection=true

# Auth — required in production: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=14
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Session cookies carry the Secure flag, which a browser only accepts over HTTPS. This defaults
# to on whenever NODE_ENV=production, so set it to false if you serve the site over plain HTTP —
# otherwise the browser discards the cookies and every sign-in bounces back to the login page.
COOKIE_SECURE=

# Required in production: code the first Admin must enter to create the account.
SETUP_CODE=

# Uploads (Multer → disk). In Docker this is the uploads volume.
UPLOADS_DIR=./data/uploads
MAX_DOC_MB=25
MAX_AUDIO_MB=50
MAX_FILES_PER_REQUEST=10

# Email (password resets, invoices). Dev: Mailpit from docker compose (UI http://localhost:8125).
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Noble Community Support <no-reply@noble.local>

# Speech-to-text: mock | openai (any OpenAI-compatible /audio/transcriptions endpoint, cloud or self-hosted)
STT_PROVIDER=mock
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Progress-note drafts: mock | anthropic
NOTE_PROVIDER=mock
ANTHROPIC_API_KEY=
NOTE_MODEL=claude-opus-5-5
# Server-side refusal fallback for the Claude API (set false on platforms that do not support it).
NOTE_FALLBACKS=true

# Xero accounting (optional). Create a free "Web app" at https://developer.xero.com/app/manage, register the
# redirect URI below on it, paste the Client id and a generated Client secret here, restart the API, then
# click "Connect to Xero" in Settings → Accounting (Xero). Xero accepts https redirect URIs, plus http://localhost.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Redirect URI to register on the Xero app. Default: APP_URL + /api/v1/integrations/xero/callback
XERO_REDIRECT_URI=
# Scopes asked for at sign-in. The default is the minimum: invoices, payments, contacts, chart of accounts.
XERO_SCOPES=
# Key that seals the saved Xero tokens in the database. Default: derived from JWT_ACCESS_SECRET.
XERO_TOKEN_KEY=

# Demo data (development only; refused in production)
SEED_DEMO_DATA=false
DEMO_ENABLED=false
DEMO_ADMIN_EMAIL=admin@noble.local
DEMO_ADMIN_PASSWORD=

# Web app (Vite reads VITE_* at build time and inlines them — never put a secret here).
# Mapbox public token (pk.…) draws the live tracking map. Without it, tracking still records
# positions and kilometres; only the map is replaced with a short explanation.
VITE_MAPBOX_TOKEN=
# Where the web app calls the API. Leave empty while both share one address (the default: Caddy
# and Vite proxy /api). Set it when the API has its own host, e.g. https://api.example.com for a
# site on https://example.com; APP_URL (or ALLOWED_ORIGINS) must then name the site's address.
# The app only uses it when opened on that site; from any other address it keeps to /api.
VITE_API_BASE_URL=

# Docker host ports (dev compose). These defaults suit a laptop. On the shared VM the 9xxx block
# below is free, so use: API_HOST_PORT=9101  MONGO_HOST_PORT=9017  MAILPIT_UI_PORT=9025  MAILPIT_SMTP_PORT=9125
API_HOST_PORT=4100
MONGO_HOST_PORT=27017
MAILPIT_UI_PORT=8125
MAILPIT_SMTP_PORT=1125

# ── Production compose only (docker-compose.prod.yml) ──
# Where the production web container publishes. The VM already uses 80, 3000-3005, 4000-4030,
# 5000-5173, 5432, 5434, 6379, 7100-7110 and 8001-8501, so Noble sits in the free 9xxx block.
HTTP_PORT=9080
HTTPS_PORT=9443
# Your domain (Caddy then gets a certificate itself), or ":80" to serve plain HTTP behind
# another proxy. Keep ":80" while the VM's own port 80 belongs to something else.
SITE_ADDRESS=:80
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=noble_app
MONGO_APP_PASSWORD=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
