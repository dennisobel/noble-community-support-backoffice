{
  "name": "@noble/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/server.ts",
    "build": "esbuild src/server.ts scripts/cli.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outdir=dist --out-extension:.js=.js",
    "start": "node --enable-source-maps dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx --env-file-if-exists=../../.env scripts/cli.ts"
  },
  "dependencies": {
    "@noble/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.129.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5",
    "@types/multer": "^2.3.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.25.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vitest": "^2.1.4"
  },
  "description": "Express API: the back office endpoints and the worker portal."
}
