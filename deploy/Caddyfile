# SITE_ADDRESS is your domain (Caddy then gets a certificate automatically), or ":80" to serve
# plain HTTP behind another proxy — which is the default here, because the VM's port 80 is already
# taken and this container is published on 9080 instead.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	request_body {
		max_size 60MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The worker portal needs the microphone for voice notes and the location for live job
		# tracking. Both are same-origin only; third-party frames get neither.
		Permissions-Policy "camera=(), geolocation=(self), microphone=(self)"
		-Server
	}

	handle /api/* {
		reverse_proxy api:4100
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
